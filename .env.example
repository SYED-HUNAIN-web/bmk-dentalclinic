# ==============================================================================
# BMK Dental & Maxillofacial Clinic — Environment Variables Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to `.env.local` for local development:
#    cp .env.example .env.local
# 2. In production (e.g. Vercel, Netlify, Docker), set these variables in your
#    hosting provider's environment variables management panel.
# 3. NEVER commit real secret keys, passwords, or tokens to version control.
#    `.env.local` is strictly ignored by `.gitignore`.
# ==============================================================================

# ──────────────────────────────────────────────────────────────────────────────
# 1. SUPABASE POSTGRESQL & AUTH (Required)
# ──────────────────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Client-Safe Public Key (Anon or Publishable)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Or modern publishable key:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Server-Only Secret Key (NEVER exposed to browser client)
# Used exclusively inside server actions and route handlers for triage & notifications
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# Or modern secret key:
# SUPABASE_SECRET_KEY=sb_secret_your_key_here

# ──────────────────────────────────────────────────────────────────────────────
# 2. SITE URL & AUTH REDIRECTS (Required for Password Recovery)
# ──────────────────────────────────────────────────────────────────────────────
# Public base URL of the website. Used for password recovery redirect targets.
# In production, set to your custom domain: https://bmkdentalclinic.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ──────────────────────────────────────────────────────────────────────────────
# 3. CLINIC NOTIFICATION DESTINATIONS
# ──────────────────────────────────────────────────────────────────────────────
# Clinic Administrator Email where new triage alerts will be sent:
CLINIC_NOTIFICATION_EMAIL=bmkdentalmaxillofacialclinic@gmail.com

# Clinic Administrator WhatsApp Number (E.164 format with country code):
# Where triage alerts will be dispatched:
CLINIC_ADMIN_WHATSAPP_NUMBER=+923332760510

# ──────────────────────────────────────────────────────────────────────────────
# 4. EMAIL PROVIDER CONFIGURATION (Resend or SMTP)
# ──────────────────────────────────────────────────────────────────────────────
# Option A: Resend API (Recommended transactional provider - https://resend.com)
RESEND_API_KEY=re_your_resend_api_key_here
NOTIFICATION_FROM_EMAIL=BMK Dental Clinic <appointments@bmkdentalclinic.com>

# Option B: Standard SMTP Relay (Alternative)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=bmkdentalmaxillofacialclinic@gmail.com
# SMTP_PASS=your-app-specific-password-here
# SMTP_FROM="BMK Dental Clinic <bmkdentalmaxillofacialclinic@gmail.com>"

# ──────────────────────────────────────────────────────────────────────────────
# 5. WHATSAPP BUSINESS DISPATCH (Twilio or Meta Cloud API)
# ──────────────────────────────────────────────────────────────────────────────
# Option A: Twilio WhatsApp API (https://twilio.com)
# Obtain from Twilio Console -> Account Info
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
# Sender number (e.g. +14155238886 for Twilio Sandbox, or your approved number)
TWILIO_WHATSAPP_NUMBER=+14155238886

# Option B: Meta / WhatsApp Cloud API (Alternative - https://developers.facebook.com)
# WHATSAPP_CLOUD_API_TOKEN=your_meta_system_user_access_token_here
# WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
